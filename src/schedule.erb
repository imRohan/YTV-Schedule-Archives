---
layout: default
metadata: site.data.schedule_metadata
---
<schedule class="page--default schedule-page">
  <h1>Today's Schedule</h1>
  <div class="schedule-header">
    <div class="schedule-meta-card">
      <div class="meta-item">
        <span class="meta-label">Broadcast Date:</span>
        <span class="meta-value"><%= metadata.date %></span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Last Updated:</span>
        <span class="meta-value"><%= metadata.updated_at %></span>
      </div>
    </div>
  </div>

  <div class="schedule-table-wrapper">
    <table class="schedule-table">
      <thead>
        <tr>
          <th>Time</th>
          <th>Show</th>
          <th>Episode</th>
          <th>Stream</th>
        </tr>
      </thead>
      <tbody>
        <% site.data.schedule.each do |row| %>
          <tr data-time="<%= row.Time %>">
            <td class="col-time"><%= row.Time %></td>
            <td class="col-show"><%= row.Show %></td>
            <td class="col-episode"><%= row.Episode.to_s.empty? ? "—" : row.Episode %></td>
            <td class="col-action">
              <% if row["Youtube Video ID"].to_s.strip.empty? %>
                <span class="no-stream">Unavailable</span>
              <% else %>
                <a href="https://www.youtube.com/watch?v=<%= row["Youtube Video ID"] %>"
                   target="_blank"
                   class="watch-btn"
                   title="Watch on YouTube">
                  <span class="play-icon">▶</span> Watch
                </a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</schedule>

<script defer>
  document.addEventListener("DOMContentLoaded", function(){
    const toMinutes = (time) => {
      const [, hour, minute, period] = time.trim().match(/^(\d{1,2}):(\d{2})\s*(am|pm)$/i) || []
      if (!hour) return null
      return (parseInt(hour) % 12 + (period.toLowerCase() === "pm" ? 12 : 0)) * 60 + parseInt(minute)
    }

    const now = new Date()
    const nowMinutes = now.getHours() * 60 + now.getMinutes()
    const currentRow = [...document.querySelectorAll(".schedule-table tbody tr[data-time]")]
      .filter((row) => {
        const minutes = toMinutes(row.dataset.time)
        return minutes !== null && minutes <= nowMinutes
      })
      .pop()

    if (currentRow) {
      currentRow.classList.add("is-current")
      currentRow.scrollIntoView({ block: "center" })
    }
  })
</script>
