<reaction-component id="reaction__container">
  <div class="reaction__tab">
    <span class="reaction__tab-text">✨</span>
  </div>
  <div class="reaction__panel">
    <div class="reaction__header">REACTIONS</div>
    <div id="reaction__actions" class="reaction__actions"></div>
  </div>
</reaction-component>

<script defer>
  document.addEventListener("DOMContentLoaded", function(){
    window.reactionComponent = new ReactionComponent(<%= raw(@reactions_map.to_json) %>)
    reactionComponent.connect()
  })
</script>
